# ── Secrets & environment ─────────────────────────────────────────────────────
.env
*.env
!.env.example
*.key
*.pem
credentials.json
service-account*.json

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
coverage.xml

# ── Data ──────────────────────────────────────────────────────────────────────
data/aegis.db
data/aegis.db-shm
data/aegis.db-wal
data/*.db
data/aegis_runs.duckdb
data/aegis_runs.duckdb.wal
data/*.duckdb
data/*.last_run.json

# ── Client packs ──────────────────────────────────────────────────────────────
# Local run records (never commit). Locked maps under maps/ are intentional.
clients/*/runs/**
!clients/*/runs/.gitkeep

# Confidential client evidence and models must not enter git. Real client data
# belongs in private cloud storage (ADR-018). CI fails if a pack with
# data_classification: confidential has tracked files under sources/ or model/.
# For a confidential pack, add clients/<id>/.gitignore ignoring sources/** and
# model/** (keep .gitkeep only), or keep those trees untracked.
clients/**/confidential_local/

# ── Node / frontend ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
frontend/.env.local

# ── Terraform ─────────────────────────────────────────────────────────────────
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.backup
infrastructure/terraform/*.tfvars
!infrastructure/terraform/*.tfvars.example

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.env.production
