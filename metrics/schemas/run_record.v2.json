{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis.local/schemas/run_record.v2.json",
  "title": "Aegis metrics run record v2",
  "description": "One structural-fragility metrics run with client_id. No forecasts or blended scores — per-metric values and statuses only. v1 records remain loadable.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "ts_utc",
    "client_id",
    "graph_name",
    "graph_sha256",
    "git_commit",
    "package_version",
    "probe",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "run_record.v2"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "ts_utc": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the run was recorded (ISO-8601)."
    },
    "client_id": {
      "type": "string",
      "minLength": 1,
      "description": "clients/<client_id>/ pack this run belongs to."
    },
    "graph_name": {
      "type": "string"
    },
    "graph_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_commit": {
      "type": ["string", "null"],
      "description": "Git commit SHA if available, else null."
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stress_ladder", "survival_floor"],
      "properties": {
        "stress_ladder": {
          "description": "true, false, or an explicit list of ladder intensities.",
          "oneOf": [
            { "type": "boolean" },
            {
              "type": "array",
              "items": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          ]
        },
        "survival_floor": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "version", "value", "status", "drivers"],
        "properties": {
          "metric": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "value": { "type": "number" },
          "status": {
            "type": "string",
            "enum": ["green", "amber", "red", "not_tested"]
          },
          "drivers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
