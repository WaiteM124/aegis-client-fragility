# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Default (when unset): local Vite dev (5173) and preview (4173) origins.
# There is no deployed dashboard URL in this repository. Before the next
# production deploy, set this on Cloud Run to the live dashboard origin, e.g.:
# CORS_ALLOWED_ORIGINS=https://YOUR-DASHBOARD-ORIGIN
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173


# ── Persistence ───────────────────────────────────────────────────────────────
PERSISTENCE_BACKEND=sqlite
SQLITE_DB_PATH=./data/aegis.db

# ── Message bus ───────────────────────────────────────────────────────────────
# Options: in_memory | pubsub_emulator | pubsub
MESSAGE_BUS_TYPE=in_memory
MESSAGE_BUS_BACKEND=in_memory

# Pub/Sub emulator (only needed when MESSAGE_BUS_TYPE=pubsub_emulator)
PUBSUB_PROJECT_ID=aegis-local
PUBSUB_EMULATOR_HOST=localhost:8085

# ── Model provider ────────────────────────────────────────────────────────────
# Options: deterministic | gemini | vertex
MODEL_PROVIDER=deterministic

# Gemini (only needed when MODEL_PROVIDER=gemini)
# GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Options: lexical | bge_m3
RETRIEVAL_BACKEND=lexical
KNOWLEDGE_BASE_PATH=./data/synthetic
RETRIEVAL_TOP_K=5

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=3
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=1.0
