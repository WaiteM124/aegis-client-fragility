# ── Builder stage ─────────────────────────────────────────────────────────────
# Installs Python dependencies into an isolated prefix so only the
# built artifacts are copied to the runtime image, keeping it lean.
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build tools needed by some native wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# Install runtime system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed packages from builder
COPY --from=builder /install /usr/local

# Copy application source
COPY backend/ ./backend/
COPY data/synthetic/ ./data/synthetic/
COPY requirements.txt .

# Project root must be on PYTHONPATH so `from backend.*` resolves
ENV PYTHONPATH=/app

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
